{
  "WingetSkipPackages": [
    "charmbracelet.crush"
  ],
  "SkipManagers": [],
  "PipSkipPackages": [
    "sglang"
  ],
  "NpmSkipPackages": [
    "@anthropic-ai/claude-code"
  ],
  "PipIgnoreHealthPackages": [
    "pylint",
    "huggingface-hub",
    "mega-py"
  ],
  "GithubTools": [
    {
      "Repo": "ikemen-engine/Ikemen-GO",
      "Tag": "nightly",
      "InstallDir": "D:\\Games\\Ikemen_nightly",
      "AssetRegex": "^Ikemen_GO-dev-windows\\.zip$"
    },
    {
      "Repo": "ggml-org/llama.cpp",
      "InstallDir": "C:\\Tools\\llama.cpp",
      "AssetRegex": "^llama-.*-bin-win-cuda.*x64\\.zip$",
      "VersionCmd": "& .\\llama-cli.exe --version",
      "VersionRegex": "build (\\d+)",
      "PreUpdate": "Stop-ScheduledTask -TaskName llama-server -ErrorAction SilentlyContinue",
      "PostUpdate": "Start-ScheduledTask -TaskName llama-server"
    },
    {
      "Repo": "neovim/neovim",
      "InstallDir": "C:\\Tools\\neovim",
      "AssetRegex": "^nvim-win64\\.zip$",
      "VersionCmd": "& .\\nvim-win64\\bin\\nvim.exe --version",
      "VersionRegex": "v([\\d.]+)"
    },
    {
      "Repo": "schmaldeo/DS4Windows",
      "InstallDir": "C:\\Tools",
      "AssetRegex": "_x64\\.zip$"
    },
    {
      "Repo": "CalcProgrammer1/OpenRGB",
      "Provider": "gitlab-artifact",
      "ProjectId": "10582521",
      "Ref": "master",
      "Job": "Windows 64",
      "InstallDir": "C:\\Tools\\OpenRGB"
    }
  ]
}
