<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AiTokenDashboard.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AiTokenDashboard"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#62D6C7"/>
        <SolidColorBrush x:Key="MutedBrush"
                         Color="#91A0AC"/>
    </Page.Resources>

    <Grid Background="#10161B"
          Padding="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="AI usage"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Token and subscription activity across your AI tools"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot"
                         Width="8"
                         Height="8"
                         Fill="#E6B85C"/>
                <TextBlock x:Name="ConnectionText"
                           Text="Connecting"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,22,0,18"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Local backend"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="ExecutableBox"
                     Grid.Column="1"
                     PlaceholderText="Path to ai-token-dashboard.exe"/>
            <TextBlock Grid.Column="2"
                       Text="Repository"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3"
                       Text="ai-token-dashboard"
                       Foreground="#C8D2DB"
                       VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton"
                    Grid.Column="4"
                    Click="Refresh_Click"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <SymbolIcon Symbol="Refresh"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,0,0,18"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#182128"
                    CornerRadius="6"
                    Padding="16,13">
                <StackPanel Spacing="4">
                    <TextBlock Text="TOOLS TRACKED"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               CharacterSpacing="80"/>
                    <TextBlock x:Name="ToolsValue"
                               Text="-"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Background="#182128"
                    CornerRadius="6"
                    Padding="16,13">
                <StackPanel Spacing="4">
                    <TextBlock Text="MONTHLY TOKENS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               CharacterSpacing="80"/>
                    <TextBlock x:Name="TokensValue"
                               Text="-"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="#182128"
                    CornerRadius="6"
                    Padding="16,13">
                <StackPanel Spacing="4">
                    <TextBlock Text="MONTHLY SUBSCRIPTIONS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               CharacterSpacing="45"/>
                    <TextBlock x:Name="CostValue"
                               Text="-"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3"
              RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Padding="12,10"
                  ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="205"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PROVIDER / PLAN"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           CharacterSpacing="50"/>
                <TextBlock Grid.Column="1"
                           Text="QUOTA / STATUS"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           CharacterSpacing="70"/>
                <TextBlock Grid.Column="2"
                           Text="TOKENS / MO"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           CharacterSpacing="45"/>
                <TextBlock Grid.Column="3"
                           Text="COST"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           CharacterSpacing="70"/>
                <TextBlock Grid.Column="4"
                           Text="RESET"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           CharacterSpacing="70"/>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind Rows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#26323A"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,12">
                                    <Grid ColumnSpacing="16"
                                          MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="205"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Plan}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="6">
                                            <TextBlock Text="{Binding Quota}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Value="{Binding QuotaPercent}"
                                                         Maximum="100"
                                                         Height="4"
                                                         Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MonthlyTokens}"
                                                   FontFamily="Consolas"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Cost}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{Binding Reset}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                    <TextBlock Text="No dashboard data yet"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorText"
                               Text="Build the local backend, then refresh to load usage."
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="4"
              Margin="0,14,0,0">
            <TextBlock x:Name="UpdatedText"
                       Text="Refreshes automatically every minute"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"/>
            <ProgressRing x:Name="LoadingRing"
                          Width="18"
                          Height="18"
                          IsActive="False"
                          HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
